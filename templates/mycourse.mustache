{{!
    @template block_mycourse/mycourse

    Displays the My Course block with:
    - Year tabs
    - Sort and status controls
    - Optional course search with autocomplete
    - Optional category grouping with collapse/expand controls

    Data hooks used by block_mycourse/main:
    - data-region="block_mycourse"
    - data-role="block_mycourse_sort"
    - data-role="block_mycourse_status_filter"
    - data-role="block_mycourse_expand_all"
    - data-role="block_mycourse_course_list"

    Core context variables:
    - instanceid
    - mycoursecontents
    - sortoptions
    - showsearch
    - searchlabel
    - searchplaceholder
    - searchurl
    - uncategorizedlabel
    - nofilteredcourseslabel
    - expandalllabel
    - collapsealllabel
    - togglecategorytemplatelabel

    Example context (json):
    {
        "instanceid": 99,
        "showsearch": true,
        "searchlabel": "Search",
        "searchplaceholder": "Search courses",
        "mycoursecontents": [
            {
                "year": "2022",
                "active": true,
                "courses": [
                    {
                        "course": {"fullname": "Course 1"},
                        "courseurl": "https://example.com/course1",
                        "startdate": 1704067200,
                        "lastaccess": 1704758400,
                        "hasstarted": 1,
                        "coursename": "course 1",
                        "coursefullname": "Course 1",
                        "categorylabel": "Business"
                    }
                ]
            }
        ]
    }
}}
<div class="tab-container block_mycourse" data-region="block_mycourse" data-instanceid="{{instanceid}}" data-uncategorized-label="{{uncategorizedlabel}}" data-nofiltered-label="{{nofilteredcourseslabel}}" data-toggle-category-template-label="{{togglecategorytemplatelabel}}" data-expand-all-label="{{expandalllabel}}" data-collapse-all-label="{{collapsealllabel}}">
    <div class="block_mycourse__controls mb-2">
        <span class="block_mycourse__control-icon" title="{{sortlabel}}">
            <i class="icon fa fa-sort-amount-desc m-0" aria-hidden="true"></i>
        </span>
        <select class="custom-select custom-select-sm w-auto" data-role="block_mycourse_sort" aria-label="{{sortlabel}}">
            {{#sortoptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/sortoptions}}
        </select>
        <span class="block_mycourse__control-icon ml-2" title="{{#str}} statusfilter, block_mycourse {{/str}}">
            <i class="icon fa fa-filter m-0" aria-hidden="true"></i>
        </span>
        <select class="custom-select custom-select-sm w-auto" data-role="block_mycourse_status_filter" aria-label="{{#str}} statusfilter, block_mycourse {{/str}}">
            <option value="all">{{#str}} statusfilterall, block_mycourse {{/str}}</option>
            <option value="started">{{#str}} statusfilterstarted, block_mycourse {{/str}}</option>
            <option value="upcoming">{{#str}} statusfilterupcoming, block_mycourse {{/str}}</option>
        </select>
        {{#showsearch}}
            <form action="{{searchurl}}" method="get" class="form-inline d-inline-flex align-items-center">
                <div class="input-group input-group-sm ml-2">
                    <input
                        type="search"
                        class="form-control"
                        id="block_mycourse-search-{{instanceid}}"
                        name="search"
                        placeholder="{{searchplaceholder}}"
                        aria-label="{{searchlabel}}"
                        required>
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-secondary">
                            {{#str}} searchgo, block_mycourse {{/str}}
                        </button>
                    </div>
                </div>
            </form>
        {{/showsearch}}
        <button type="button" class="btn btn-link p-0 ml-2 d-none block_mycourse__expand-all" data-role="block_mycourse_expand_all">{{expandalllabel}}</button>
    </div>

    {{! Build Year Tabs}}
    <ul class="nav nav-tabs" role="tablist">
        {{#mycoursecontents}}
            <li class="nav-item">
                <a class="nav-link {{#active}}active{{/active}}" id="tab-{{instanceid}}-{{year}}" data-toggle="tab" href="#content-{{instanceid}}-{{year}}" role="tab" aria-controls="content-{{instanceid}}-{{year}}" aria-selected="{{#active}}true{{/active}}">{{year}}</a>
            </li>
        {{/mycoursecontents}}
    </ul>

    {{! Courses by year}}
    <div class="tab-content">
        {{#mycoursecontents}}
            <div class="tab-pane fade {{#active}}show active{{/active}}" id="content-{{instanceid}}-{{year}}" role="tabpanel" aria-labelledby="tab-{{instanceid}}-{{year}}">
                <ul class="list-group list-group-flush" data-role="block_mycourse_course_list">
                    {{#courses}}
                        <li class="list-group-item" data-sort-startdate="{{startdate}}" data-sort-lastaccess="{{lastaccess}}" data-course-started="{{hasstarted}}" data-sort-category="{{categorysort}}" data-sort-name="{{coursename}}" data-course-fullname="{{coursefullname}}" data-sort-category-label="{{categorylabel}}">
                            <div class="d-flex align-items-center">
                                {{#image}}
                                    <div class="block_mycourse__summary-image" style='background-image: url("{{image}}");'></div>
                                {{/image}}
                                <div class="block_mycourse__course-content">
                                    {{#category}}
                                        <span class="block_mycourse__category-meta text-muted" title="{{category}}">{{category}}</span>
                                    {{/category}}
                                        <a href="{{courseurl}}" class="aalink coursename block_mycourse__course-name" title="{{course.fullname}}">{{course.fullname}}</a>
                                    {{#status}}
                                        <div class="block_mycourse__detail-text text-muted">{{status}}</div>
                                    {{/status}}
                                    {{#hasstartstatus}}
                                        <div class="block_mycourse__detail-text text-muted">{{startstatus}}</div>
                                    {{/hasstartstatus}}
                                    {{#haslastaccess}}
                                        <div class="block_mycourse__detail-text text-muted">{{lastaccesstext}}</div>
                                    {{/haslastaccess}}
                                    {{#hasprogress}}
                                        <div class="progress-text font-weight-light">
                                            <span>{{progress}}% complete</span>
                                        </div>
                                    {{/hasprogress}}
                                </div>
                            </div>
                        </li>
                    {{/courses}}
                    {{^courses}} {{!If there are no courses.}}
                        <li class="list-group-item">
                            <div class="alert alert-warning" role="alert">
                                <i class="fa fa-exclamation-circle" aria-hidden="true"></i> {{nocourse}}
                            </div>
                        </li>
                    {{/courses}}
                </ul>
            </div>
        {{/mycoursecontents}}
    </div>
</div>

{{#js}}
require(['block_mycourse/main'], function(Main) {
    Main.init();
});
{{/js}}
